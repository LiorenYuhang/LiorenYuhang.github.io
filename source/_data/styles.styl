/* ========================================
   黑白极简风格
   字体: 霞鹜文楷 + Fira Code
   ======================================== */

/* --- 霞鹜文楷字体 --- */
@import url('https://cdn.jsdelivr.net/npm/lxgw-wenkai-webfont@1.7.0/style.css');

/* --- 页面背景灰黑渐变 --- */
body {
  font-family: "LXGW WenKai", "PingFang SC", "Microsoft YaHei", sans-serif;
  background: linear-gradient(180deg, #f0f0f0 0%, #e8e8e8 15%, #ffffff 40%);
  background-attachment: fixed;
}

/* --- 暗色模式下渐变 --- */
[data-theme="dark"] body {
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 30%, #0f0f23 100%);
  background-attachment: fixed;
}

/* --- 代码保持等宽 --- */
code, pre, .highlight {
  font-family: "Fira Code", "Cascadia Code", "Consolas", "Courier New", monospace;
}

/* --- 头像强制正方形+圆形 --- */
.site-author-image {
  width: 100px !important;
  height: 100px !important;
  border-radius: 50% !important;
  object-fit: cover;
}

/* --- 隐藏日志/分类/标签统计 --- */
.site-state-wrap {
  display: none !important;
}

/* --- 卡片微调 --- */
.post-block {
  border-radius: 12px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.06);
  transition: box-shadow 0.3s ease;
}

.post-block:hover {
  box-shadow: 0 4px 16px rgba(0,0,0,0.1);
}

/* --- 侧边栏卡片 --- */
.sidebar-inner .sidebar-nav,
.sidebar-inner .sidebar-panel,
.links-of-blogroll,
.links-of-author {
  border-radius: 10px;
}

/* --- 文章标题 --- */
.posts-expand .post-title {
  font-weight: 600;
}

.posts-expand .post-title-link {
  transition: color 0.2s ease;
}

/* --- 分割线 --- */
hr {
  background: linear-gradient(90deg, transparent, #ddd, #ddd, transparent);
  height: 1px;
  border: none;
}

/* --- 图片圆角 --- */
.post-body img {
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

/* --- 行内代码 --- */
code {
  border-radius: 4px;
  padding: 2px 6px;
}

/* ========================================
   侧边栏定制样式
   ======================================== */

/* --- 顶部标题：大字显示副标题内容 --- */
.site-title {
  font-size: 22px !important;
  font-weight: 600;
  line-height: 1.8;
  text-align: center;
}

.site-subtitle {
  display: none !important;
}

/* --- 顶部黑色区域 --- */
.header {
  background: #222 !important;
}

.header-inner {
  background: #222 !important;
  padding: 25px 0 !important;
}

.site-meta {
  background: #222 !important;
}

.header .site-title,
.header .site-title a {
  color: #ddd !important;
}

/* --- 侧边栏标签：站点概览在左，文章目录在右 --- */
.sidebar-nav {
  display: flex !important;
  flex-direction: row !important;
  width: 100% !important;
}

.sidebar-nav-overview {
  order: 1 !important;
}

.sidebar-nav-toc {
  order: 2 !important;
  margin-left: auto !important;
}

/* --- 侧边栏菜单 --- */
.sidebar-menu {
  margin-top: 16px;
  padding: 12px 0;
  border-top: 1px solid #eee;
  border-bottom: 1px solid #eee;
}

.sidebar-menu a {
  display: block;
  padding: 8px 16px;
  color: #555;
  font-size: 15px;
  text-decoration: none;
  transition: all 0.2s ease;
  border-radius: 6px;
  margin: 2px 0;
}

.sidebar-menu a:hover {
  background: #f5f5f5;
  color: #222;
}

[data-theme="dark"] .sidebar-menu {
  border-color: #333;
}

[data-theme="dark"] .sidebar-menu a:hover {
  background: #2a2a2a;
  color: #ddd;
}

/* --- 邮箱复制提示 --- */
.email-copied-toast {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(34, 34, 34, 0.92);
  color: #fff;
  padding: 4px 14px;
  border-radius: 6px;
  font-size: 13px;
  white-space: nowrap;
  z-index: 10;
  pointer-events: none;
  animation: toast-fade 0.25s ease;
}

@keyframes toast-fade {
  from { opacity: 0; transform: translate(-50%, -50%) scale(0.9); }
  to   { opacity: 1; transform: translate(-50%, -50%) scale(1); }
}

/* ========================================
   About 页面
   ======================================== */

html.is-about-page .site-title {
  font-size: 18px !important;
  line-height: 1.65;
  opacity: 0.88;
}

html.is-about-page .post-header,
html.is-about-page .post-title {
  text-align: left;
}

html.is-about-page .about-profile-card {
  display: block !important;
  margin: 1rem 0;
  padding: 1.1rem 1.2rem;
  border: 1px solid #dedede;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.55);
}

html.is-about-page .about-profile-card .site-author {
  margin: 0;
  text-align: left;
}

html.is-about-page .about-profile-card .site-author-image {
  display: none;
}

.about-profile-name,
.about-profile-role,
.about-profile-focus {
  margin: 0;
}

.about-profile-name {
  font-size: 1.1em;
  font-weight: 600;
}

.about-profile-role {
  margin-top: 0.35rem;
  color: #555;
  font-size: 0.92em;
}

.about-profile-focus {
  margin-top: 0.35rem;
  color: #666;
  font-size: 0.88em;
  line-height: 1.6;
}

html.is-about-page .about-profile-card .links-of-author {
  margin: 0.9rem 0 0;
  padding-top: 0.75rem;
  border-top: 1px solid #e0e0e0;
}

html.is-about-page .about-profile-card .links-of-author-item {
  display: block;
  margin-top: 0.45rem;
}

html.is-about-page .about-project h3 {
  white-space: nowrap;
}

.about-intro {
  margin: 0 0 2rem;
  padding: 1.2rem 1.35rem;
  border-left: 3px solid #555;
  background: rgba(255, 255, 255, 0.55);
}

.about-intro p:last-child {
  margin-bottom: 0;
}

.about-kicker {
  margin: 0 0 0.6rem;
  color: #555;
  font-size: 1.05em;
  font-weight: 600;
}

.about-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem;
  margin: 1rem 0 2rem;
}

.about-tag {
  padding: 0.3rem 0.7rem;
  border: 1px solid #d5d5d5;
  border-radius: 4px;
  color: #555;
  font-size: 0.9em;
  line-height: 1.4;
}

.about-projects {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
  margin: 1rem 0 2rem;
}

.about-project {
  padding: 1.1rem 1.2rem;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.55);
}

.about-project h3 {
  margin: 0 0 0.55rem;
  font-size: 1em;
}

.about-project p {
  margin: 0;
  color: #666;
  font-size: 0.92em;
  line-height: 1.7;
}

[data-theme="dark"] .about-intro,
[data-theme="dark"] .about-project,
[data-theme="dark"] .about-profile-card {
  border-color: #444;
  background: rgba(30, 30, 46, 0.55);
}

[data-theme="dark"] .about-kicker,
[data-theme="dark"] .about-tag,
[data-theme="dark"] .about-project p,
[data-theme="dark"] .about-profile-role,
[data-theme="dark"] .about-profile-focus {
  color: #bbb;
}

[data-theme="dark"] .about-tag {
  border-color: #555;
}

[data-theme="dark"] .about-profile-card .links-of-author {
  border-color: #444;
}

@media (max-width: 767px) {
  .about-projects {
    grid-template-columns: 1fr;
  }

  .about-intro {
    padding: 1rem;
  }
}

// ========================================
// AI Assistant 面板 — 暗色模式
// ========================================

[data-theme="dark"]
  #ai-panel
    background: #1e1e2e
    color: #ddd

  #ai-panel-header
  #ai-panel-status
  #ai-panel-input-wrap
    border-color: #333

  #ai-panel-header .ai-title
    color: #ddd

  #ai-panel-status
    color: #888

  #ai-panel-input
    background: #2a2a3e
    color: #ddd
    border-color: #444
    &:focus
      border-color: #666
      background: #2a2a3e

  .ai-msg-user .ai-bubble
    background: #1a3a5c
    color: #ddd

  .ai-msg-bot .ai-bubble
    background: #2a2a3e
    color: #ddd

  .ai-source-card
    background: #252536
    border-color: #333
    &:hover
      background: #2a2a3e

    .ai-src-title
      color: #ddd

    .ai-src-excerpt
      color: #999

  .ai-prompt-tag
    background: #2a2a3e
    color: #ddd
    border-color: #444
    &:hover
      background: #333

  .ai-btn-send
    background: #555
    &:hover
      background: #777

  .ai-btn-stop
    background: #444
    color: #ccc

  #ai-panel-messages::-webkit-scrollbar-thumb
    background: #444

// prefers-color-scheme 后备
@media (prefers-color-scheme: dark)
  html:not([data-theme])
    #ai-panel
      background: #1e1e2e
      color: #ddd
    #ai-panel-input
      background: #2a2a3e
      color: #ddd
      border-color: #444
    .ai-msg-user .ai-bubble
      background: #1a3a5c
      color: #ddd
    .ai-msg-bot .ai-bubble
      background: #2a2a3e
      color: #ddd

